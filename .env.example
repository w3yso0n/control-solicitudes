# Firma de la sesión. En Vercel conviene definirla.
# Si se omite, la app usa el secreto de demostración que está en el código.
AUTH_SECRET="cambia-esto"

# Auth.js ya confía en el host desde el código (trustHost: true).
# Esta variable no cambia el comportamiento; queda por si el proyecto de Vercel la espera.
AUTH_TRUST_HOST=true

# Esta versión no guarda archivos: las fotos viven en memoria del navegador.
# La variable solo la consultarían rutas que están apagadas.
UPLOAD_DIR=./uploads

# Los accesos no van aquí. Están fijos en lib/mock/demo-usuarios.ts
# (admin, candidata, cuantiva, operador y territorio @demo.mx, contraseña demo).
